# Backend de Ubikka. Sin barra final.
# Solo la usa el servidor de Next: el navegador nunca habla con la API.
API_URL=http://localhost:3001

# URL pública del panel (la usa el backend para armar los links de los emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL del sitio público para copiar links de propiedades desde el panel.
# Si no está definida, el botón usa el origen actual.
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:5173

# Webhook sincrónico del workflow web de Sofi en n8n. Es server-only y se usa
# únicamente en /probar-agente; sin esta variable la pantalla muestra un error.
AGENT_CHAT_WEBHOOK_URL=
